# Copy to .env.local for local development, or set these in Vercel -> Settings -> Environment Variables.
# Leave any group blank to keep that part of the app in sandbox mode.

# ---- Database (MongoDB Atlas). Required on Vercel. ----
MONGODB_URI=
MONGODB_DB=eib

# First run on an empty database creates this super admin. Must be a Google account.
SUPER_ADMIN_EMAIL=josefm2173@gmail.com
SUPER_ADMIN_NAME=Josef Marshall
# Set to "true" ONLY on a staging deployment to load the sandbox sample data.
SEED_SAMPLE_DATA=false

# ---- Google sign-in (NextAuth). Both AUTH_GOOGLE_* set = real sign-in on; blank = dev role switcher. ----
# Generate AUTH_SECRET with:  openssl rand -base64 32   (or any long random string)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed if Vercel cannot infer the site URL (e.g. custom domain): AUTH_URL=https://your-domain
AUTH_TRUST_HOST=true

# ---- EIB Email Agent (POST /api/agent/inbound). Leave blank to keep the agent off. ----
# The agent's own address on a domain whose receiving is enabled in Resend (MX record added).
AGENT_ADDRESS=assistant@joineib.ca
# Signing secret of the Resend webhook for the email.received event.
RESEND_WEBHOOK_SECRET=
# Josef's addresses (comma-separated). Only verified mail from these may edit data. Defaults to SUPER_ADMIN_EMAIL.
JOSEF_ADDRESSES=josefm2173@gmail.com
# Who gets answers: whole domains and/or individual addresses (comma-separated).
TFS_WHITELIST_DOMAINS=tfs.ca
TFS_WHITELIST_ADDRESSES=
# Separate Atlas users: read-only for answers, read/write (mentors, lessons, settings) for Josef's edits.
# Blank = the main MONGODB_URI (or the sandbox file) is used for both.
MONGODB_AGENT_READ_URI=
MONGODB_AGENT_WRITE_URI=
# Google Drive: the service account key JSON (one line) and the "EIB Documents" folder id.
GOOGLE_SERVICE_ACCOUNT_JSON=
EIB_DRIVE_FOLDER_ID=
# Claude. Blank = a small mock answers (sandbox only).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Protects the daily reminder endpoint (/api/agent/remind) that Vercel Cron calls.
CRON_SECRET=
