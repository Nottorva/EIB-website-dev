# Copy to .env.local for local development, or set these in Vercel -> Settings -> Environment Variables.
# Leave any group blank to keep that part of the app in sandbox mode.

# ---- Database (MongoDB Atlas). Required on Vercel. ----
MONGODB_URI=
MONGODB_DB=eib

# First run on an empty database creates this super admin. Must be a Google account.
SUPER_ADMIN_EMAIL=josefm2173@gmail.com
SUPER_ADMIN_NAME=Josef Marshall
# Set to "true" ONLY on a staging deployment to load the sandbox sample data.
SEED_SAMPLE_DATA=false

# ---- Google sign-in (NextAuth). Both AUTH_GOOGLE_* set = real sign-in on; blank = dev role switcher. ----
# Generate AUTH_SECRET with:  openssl rand -base64 32   (or any long random string)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed if Vercel cannot infer the site URL (e.g. custom domain): AUTH_URL=https://your-domain
AUTH_TRUST_HOST=true
